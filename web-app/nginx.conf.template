# Malik Team Connect — nginx server block TEMPLATE.
#
# entrypoint.sh renders this into /etc/nginx/conf.d/default.conf at container
# start, substituting ONLY ${PORT}:
#   - VPS / docker-compose: PORT is not set for the web service -> default 80
#     (exactly what the old static nginx.conf did).
#   - Railway: Railway injects PORT and routes traffic to it, so nginx must
#     listen on $PORT instead of 80.
# All other nginx variables ($uri, $host, ...) are written WITHOUT braces on
# purpose, so the ${PORT}-only substitution can never touch them.
# nginx.conf in this folder is the same block with port 80 filled in, kept
# as a readable reference.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime config must never be cached: it is regenerated at container
    # start and points the app at this deployment's API / LiveKit URLs.
    location = /config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # SPA fallback: every unknown path returns the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache the hashed build assets.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
